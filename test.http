###-------------------------###
### CHECK AUTH ###
###-------------------------###


### Check auth without token
GET {{baseUrl}}/auth/check


### Check auth with token
GET {{baseUrl}}/auth/check
Authorization: Bearer {{token}}


### Check auth with token user 2
GET {{baseUrl}}/auth/check
Authorization: Bearer {{token2}}

###-------------------------###
### CREATE ACCOUNT ###
###-------------------------###


### Create account
POST {{baseUrl}}/accounts
Authorization: Bearer {{token}}
Content-Type: application/json


### Create account user 2
POST {{baseUrl}}/accounts
Authorization: Bearer {{token2}}
Content-Type: application/json



### Get my accounts
GET {{baseUrl}}/accounts
Authorization: Bearer {{token}}


### Get my accounts user 2
GET {{baseUrl}}/accounts
Authorization: Bearer {{token2}}


### Get account by id user 1 account 1
GET {{baseUrl}}/accounts/{{accountId1user1}}
Authorization: Bearer {{token}}

### Get account by id user 2 accounnt 3
GET {{baseUrl}}/accounts/{{accountId1user2}}
Authorization: Bearer {{token2}}


### Deposit user 1
POST {{baseUrl}}/accounts/{{accountId1user1}}/deposit
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": "1000.00"
}

### Deposit user 2
POST {{baseUrl}}/accounts/{{accountId1user2}}/deposit
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "amount": "1000.00"
}


### Withdraw user 1 account 1
POST {{baseUrl}}/accounts/{{accountId1user1}}/withdraw
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": "250.00"
}

### Withdraw user 2 account 1
POST {{baseUrl}}/accounts/{{accountId1user2}}/withdraw
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "amount": "250.00"
}


### Withdraw too much
POST {{baseUrl}}/accounts/1/withdraw
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": "999999.00"
}

### Create second account
POST {{baseUrl}}/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{}


### Transfer between accounts of the same user
POST {{baseUrl}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "from_account_id": 1,
  "to_account_id": 2,
  "amount": "100.00",
  "description": "test transfer"
}


### Transfer from user 1 to user 2
POST {{baseUrl}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "from_account_id": {{accountId1user1}},
  "to_account_id": {{accountId1user2}},
  "amount": "500.00",
  "description": "transfer from user1 to user2"
}


### Transfer too much
POST {{baseUrl}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "from_account_id": 1,
  "to_account_id": 2,
  "amount": "999999.00",
  "description": "too much"
}


### Transfer to same account
POST {{baseUrl}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "from_account_id": 1,
  "to_account_id": 1,
  "amount": "100.00",
  "description": "same account"
}

