### Send test email
GET {{baseUrl}}/notifications/test
Authorization: Bearer {{token}}

### Get analytics
GET {{baseUrl}}/analytics
Authorization: Bearer {{token}}


### Predict balance default 30 days
GET {{baseUrl}}/accounts/1/predict
Authorization: Bearer {{token}}


### Predict balance 365 days
GET {{baseUrl}}/accounts/1/predict?days=365
Authorization: Bearer {{token}}


### Predict balance invalid days
GET {{baseUrl}}/accounts/1/predict?days=366
Authorization: Bearer {{token}}


### Predict balance 30 days with statistics
GET {{baseUrl}}/accounts/1/predict?days=30
Authorization: Bearer {{token}}


### Predict balance 365 days with statistics
GET {{baseUrl}}/accounts/1/predict?days=365
Authorization: Bearer {{token}}


### Create card with one-time CVV
POST {{baseUrl}}/cards
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "account_id": 1
}


### Pay by card with CVV
POST {{baseUrl}}/cards/2/pay
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": "50.00",
  "cvv": "{{cvvForCardID2}}",
  "description": "card payment with cvv"
}

### Pay by card with wrong CVV
POST {{baseUrl}}/cards/2/pay
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": "50.00",
  "cvv": "999",
  "description": "wrong cvv test"
}


### Login for logout test
POST {{baseUrl}}/login
Content-Type: application/json

{
  "login": "test@example.com",
  "password": "password123"
}


### Check auth before logout
GET {{baseUrl}}/auth/check
Authorization: Bearer {{token}}


### Logout
POST {{baseUrl}}/logout
Authorization: Bearer {{token2}}


### Check auth after logout
GET {{baseUrl}}/auth/check
Authorization: Bearer {{token}}

### Request MFA code for exact transfer
POST {{baseUrl}}/mfa/request
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "purpose": "transfer",
  "from_account_id": 3,
  "to_account_id": 1,
  "amount": "100.00"
}

### Transfer with exact MFA
POST {{baseUrl}}/transfer
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "from_account_id": 3,
  "to_account_id": 1,
  "amount": "100.00",
  "description": "transfer with exact mfa",
  "mfa_code": "{{mfaCode}}"
}


### Transfer with same MFA but different amount
POST {{baseUrl}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "from_account_id": 1,
  "to_account_id": 2,
  "amount": "1000.00",
  "description": "wrong operation details",
  "mfa_code": "{{mfaCode}}"
}

### Request MFA for card payment
POST {{baseUrl}}/mfa/request
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "purpose": "card_payment",
  "card_id": 3,
  "amount": "50.00"
}

### Pay by card with CVV and MFA
POST {{baseUrl}}/cards/3/pay
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "amount": "50.00",
  "cvv": "{{cvvForCardID3}}",
  "mfa_code": "{{mfaCode}}",
  "description": "card payment with mfa"
}
### Request MFA for credit create
POST {{baseUrl}}/mfa/request
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "purpose": "credit_create",
  "account_id": 3,
  "principal_amount": "50000.00",
  "term_months": 6
}

### Create credit with MFA
POST {{baseUrl}}/credits
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "account_id": 3,
  "principal_amount": "50000.00",
  "term_months": 6,
  "mfa_code": "{{mfaCode}}"
}


